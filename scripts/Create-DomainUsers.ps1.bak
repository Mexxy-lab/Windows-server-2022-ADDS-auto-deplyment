
[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [string]$CSVPath,

    [string]$DomainDN = "DC=pumejlab,DC=com",

    [string]$DomainUPNSuffix = "pumejlab.com",

    [string]$LogDirectory = "C:\Temp\ADLab",

    # Supply this securely through Ansible Vault.
    [string]$DefaultUserPassword = ""
)

$ErrorActionPreference = "Stop"
Import-Module ActiveDirectory

if (-not (Test-Path -LiteralPath $LogDirectory)) {
    New-Item -ItemType Directory -Path $LogDirectory -Force |
        Out-Null
}

$LogFile = Join-Path $LogDirectory "ADUserImportLog.txt"
Start-Transcript -Path $LogFile -Append

try {
    if (-not (Test-Path -LiteralPath $CSVPath)) {
        throw "CSV file not found: $CSVPath"
    }

    $ADUsers = @(Import-Csv -LiteralPath $CSVPath)

    if ($ADUsers.Count -eq 0) {
        throw "The CSV file contains no user records."
    }

    $requiredColumns = @(
        "DisplayName",
        "username",
        "email",
        "UPN",
        "OU",
        "password",
        "company",
        "department"
    )

    $actualColumns = @($ADUsers[0].PSObject.Properties.Name)

    foreach ($column in $requiredColumns) {
        if ($actualColumns -notcontains $column) {
            throw "Required CSV column is missing: $column"
        }
    }

    # Validate and create each OU, from its parent down to its child.
    $OUs = @(
        $ADUsers |
            ForEach-Object { $_.OU.Trim() } |
            Where-Object { $_ } |
            Sort-Object -Unique
    )

    foreach ($OU in $OUs) {
        if (-not $OU.StartsWith("OU=", [StringComparison]::OrdinalIgnoreCase)) {
            throw "OU must be a distinguished name beginning with OU=: $OU"
        }

        if (-not $OU.EndsWith($DomainDN, [StringComparison]::OrdinalIgnoreCase)) {
            throw "OU '$OU' is not under the configured domain '$DomainDN'."
        }

        $parts = $OU -split '(?<!\\),'
        $parentDN = $DomainDN

        # Build missing OU levels from the domain root downward.
        $ouParts = @($parts | Where-Object {
            $_ -match '^\s*OU='
        })

        [array]::Reverse($ouParts)

        foreach ($part in $ouParts) {
            $component = $part.Trim()
            $currentDN = "$component,$parentDN"

            $existingOU = Get-ADOrganizationalUnit `
                -Identity $currentDN -ErrorAction SilentlyContinue

            if (-not $existingOU) {
                $ouName = $component -replace '^\s*OU=', ''

                # Decode escaped commas and backslashes in OU names.
                $ouName = $ouName -replace '\\,', ',' -replace '\\\\', '\'

                New-ADOrganizationalUnit `
                    -Name $ouName `
                    -Path $parentDN `
                    -ProtectedFromAccidentalDeletion $true

                Write-Output "Created OU: $currentDN"
            }

            $parentDN = $currentDN
        }

        # Validate the complete OU path supplied in the CSV.
        Get-ADOrganizationalUnit -Identity $OU | Out-Null
    }

    $created = 0
    $skipped = 0
    $failed = 0

    foreach ($User in $ADUsers) {
        $Username = ([string]$User.username).Trim()
        $DisplayName = ([string]$User.DisplayName).Trim()
        $OU = ([string]$User.OU).Trim()

        try {
            if ([string]::IsNullOrWhiteSpace($Username)) {
                throw "Username is blank."
            }

            if ([string]::IsNullOrWhiteSpace($DisplayName)) {
                throw "DisplayName is blank for '$Username'."
            }

            if (-not (Get-ADOrganizationalUnit -Identity $OU `
                    -ErrorAction SilentlyContinue)) {
                throw "OU does not exist: $OU"
            }

            $existingUser = Get-ADUser `
                -Filter "SamAccountName -eq '$($Username.Replace("'","''"))'" `
                -ErrorAction SilentlyContinue

            if ($existingUser) {
                Write-Output "Skipped existing user: $Username"
                $skipped++
                continue
            }

            $firstName = ([string]$User.DisplayName).Trim() -split '\s+', 2
            $givenName = $firstName[0]
            $surname = if ($firstName.Count -gt 1) { $firstName[1] } else { "" }

            $upn = ([string]$User.UPN).Trim()
            if ([string]::IsNullOrWhiteSpace($upn)) {
                $upn = "$Username@$DomainUPNSuffix"
            }

            # Prefer a per-user CSV password; otherwise use the vault value.
            $plainPassword = ([string]$User.password).Trim()
            if ([string]::IsNullOrWhiteSpace($plainPassword)) {
                $plainPassword = $DefaultUserPassword
            }

            if ([string]::IsNullOrWhiteSpace($plainPassword)) {
                throw "No password supplied in CSV or DefaultUserPassword."
            }

            $securePassword = ConvertTo-SecureString `
                $plainPassword -AsPlainText -Force

            $params = @{
                SamAccountName        = $Username
                UserPrincipalName     = $upn
                Name                  = $DisplayName
                DisplayName           = $DisplayName
                GivenName             = $givenName
                Surname               = $surname
                Path                  = $OU
                AccountPassword       = $securePassword
                Enabled               = $true
                ChangePasswordAtLogon = $true
                PasswordNeverExpires  = $false
            }

            $optionalMappings = @{
                Company       = "company"
                Department    = "department"
                EmailAddress  = "email"
                StreetAddress = "streetaddress"
                City          = "city"
                State         = "state"
                PostalCode    = "zipcode"
                Country       = "country"
                OfficePhone   = "telephone"
                Title         = "jobtitle"
            }

            foreach ($parameterName in $optionalMappings.Keys) {
                $csvColumn = $optionalMappings[$parameterName]
                $value = ([string]$User.$csvColumn).Trim()

                if (-not [string]::IsNullOrWhiteSpace($value)) {
                    $params[$parameterName] = $value
                }
            }

            New-ADUser @params
            Write-Output "Created user: $Username in $OU"
            $created++
        }
        catch {
            $errorMessage = $_.Exception.Message
            $errorType = $_.Exception.GetType().FullName

            Write-Warning "Failed to process '$Username': [$errorType] $errorMessage"
            Add-Content -LiteralPath $LogFile -Value (
                "[$(Get-Date -Format o)] User='$Username'; ErrorType='$errorType'; Error='$errorMessage'"
            )

            $failed++
        }
    }

    Write-Output "Import summary: Created=$created; Skipped=$skipped; Failed=$failed"

    if ($failed -gt 0) {
        throw "$failed user record(s) failed. Review the transcript log."
    }
}
finally {
    Stop-Transcript
}
