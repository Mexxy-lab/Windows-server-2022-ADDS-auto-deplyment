---
- name: Diagnose Active Directory validation
  hosts: domain_controller
  gather_facts: false

  vars_files:
    - ../group_vars/windows.yml
    - ../group_vars/vault.yml

  vars:
    ansible_user: 'PUMEJLAB\Administrator'
    ansible_password: "{{ domain_admin_password }}"

  tasks:
    - name: Diagnose domain, OUs, and sample accounts
      ansible.windows.win_powershell:
        script: |
          $ErrorActionPreference = 'Stop'
          Import-Module ActiveDirectory

          $domain = Get-ADDomain -Identity '{{ domain_name }}' -ErrorAction Stop
          Write-Output "Domain found: $($domain.DNSRoot)"

          $requiredOUs = @(
            'Admins', 'Management', 'IT',
            'HR', 'Marketing', 'Sales'
          )

          foreach ($name in $requiredOUs) {
            $dn = "OU=$name,$($domain.DistinguishedName)"
            Get-ADOrganizationalUnit -Identity $dn -ErrorAction Stop |
              Out-Null
            Write-Output "OU found: $name"
          }

          $csvPath = 'C:\Temp\ADLab\user_accounts_final.csv'
          if (-not (Test-Path $csvPath)) {
            throw "Expected user CSV is missing."
          }

          $rows = @(Import-Csv -Path $csvPath)
          Write-Output "CSV row count: $($rows.Count)"

          foreach ($row in @($rows | Select-Object -First 3)) {
            $user = Get-ADUser `
              -Filter "SamAccountName -eq '$($row.username)'" `
              -Properties UserPrincipalName, DistinguishedName `
              -ErrorAction SilentlyContinue

            if (-not $user) {
              Write-Output "Found=False; account lookup did not match"
              continue
            }

            Write-Output "Found=True; UPNMatch=$($user.UserPrincipalName -eq $row.UPN)"
            Write-Output "CSV OU=$($row.OU)"
            Write-Output "AD location=$($user.DistinguishedName.Substring($user.DistinguishedName.IndexOf(',') + 1))"
          }

          throw "Diagnostic complete; full validation has not been performed."
      register: ad_diagnostic
      no_log: false

    - name: Show diagnostic output
      ansible.builtin.debug:
        var: ad_diagnostic.output
