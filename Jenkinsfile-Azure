
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
    }

    stages {
        stage('SCM Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "Azure Windows Server 2022 AD DS Deployment"
                    git log -1 --oneline
                '''
            }
        }

        stage('Pre-deployment Validation') {
            steps {
                sh '''
                    set -e

                    # Confirm that the deployment script exists and has valid Bash syntax.
                    test -f startupadds-azure.sh
                    bash -n startupadds-azure.sh

                    # Confirm that all required deployment tools are installed.
                    for cmd in terraform az ansible-playbook ansible \
                               ansible-inventory ansible-vault \
                               ansible-galaxy python3; do
                        command -v "$cmd" >/dev/null 2>&1 || {
                            echo "ERROR: Missing required command: $cmd"
                            exit 1
                        }
                    done

                    # Confirm that the Azure Terraform configuration exists.
                    test -f azure-ad-lab-terraform/versions.tf
                    test -f azure-ad-lab-terraform/main.tf
                    test -f azure-ad-lab-terraform/terraform.tfvars

                    echo "Azure deployment prerequisites passed."
                '''
            }
        }

        stage('Deployment Approval') {
            steps {
                script {
                    // Approval happens before the deployment script starts.
                    // The script will create and display its Terraform plan afterward.
                    input(
                        message: 'Approve deployment of Windows Server 2022 AD DS infrastructure in Azure? This may create billable resources.',
                        ok: 'Approve Azure Deployment'
                    )
                }
            }
        }

        stage('Deploy Azure Active Directory') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'azure-service-principal',
                        usernameVariable: 'ARM_CLIENT_ID',
                        passwordVariable: 'ARM_CLIENT_SECRET'
                    ),
                    string(
                        credentialsId: 'azure-tenant-id',
                        variable: 'ARM_TENANT_ID'
                    ),
                    string(
                        credentialsId: 'azure-subscription-id',
                        variable: 'ARM_SUBSCRIPTION_ID'
                    ),
                    file(
                        credentialsId: 'ansible-vault-password-file',
                        variable: 'ANSIBLE_VAULT_PASSWORD_FILE'
                    )
                ]) {
                    withEnv(['JENKINS_AUTO_APPROVE=true']) {
                        sh '''
                            set -e
                            set +x

                            # Keep Azure CLI authentication files in a temporary
                            # directory rather than the Jenkins user's home directory.
                            export AZURE_CONFIG_DIR="$(mktemp -d)"
                            chmod 700 "$AZURE_CONFIG_DIR"

                            # Remove temporary Azure authentication data when the
                            # deployment command exits, whether successful or not.
                            cleanup_azure_auth() {
                                az logout >/dev/null 2>&1 || true
                                rm -rf -- "$AZURE_CONFIG_DIR"
                            }
                            trap cleanup_azure_auth EXIT

                            # Authenticate using the Jenkins-managed Azure
                            # Service Principal credentials.
                            az login \
                                --service-principal \
                                --username "$ARM_CLIENT_ID" \
                                --password "$ARM_CLIENT_SECRET" \
                                --tenant "$ARM_TENANT_ID" \
                                --output none

                            # Select the subscription used by this deployment.
                            az account set --subscription "$ARM_SUBSCRIPTION_ID"

                            # Verify the authenticated Azure subscription.
                            az account show \
                                --query '{name:name,id:id,tenantId:tenantId}' \
                                --output table

                            # Export the subscription ID for Terraform's
                            # AzureRM provider authentication.
                            export ARM_SUBSCRIPTION_ID
                            export ARM_TENANT_ID
                            export ARM_CLIENT_ID
                            export ARM_CLIENT_SECRET

                            # Run the Azure AD DS deployment.
                            chmod 700 startupadds-azure.sh
                            ./startupadds-azure.sh
                        '''
                    }
                }
            }
        }

        stage('Deployment Summary') {
            steps {
                echo 'Azure Windows Server 2022 AD DS deployment completed.'
                echo 'Review the deployment log and Terraform outputs.'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Azure Active Directory deployment completed.'
        }

        failure {
            echo 'FAILED: Azure Active Directory deployment encountered an error.'
            echo 'Review the Jenkins console output and deployment log.'
        }

        aborted {
            echo 'Azure deployment was aborted or approval was declined.'
        }

        always {
            echo 'Azure AD DS Jenkins pipeline execution finished.'
        }
    }
}
